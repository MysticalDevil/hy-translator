root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_imports_layout = *
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.xml]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[gradle/libs.versions.toml]
indent_size = 2

[*.pro]
indent_size = 4

[*.properties]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
